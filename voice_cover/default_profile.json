{
  "name": "Your singing voice",
  "runtime_python": "python",
  "applio": "tools/Applio",
  "model": "models/voice.pth",
  "index": "models/voice.index",
  "ffmpeg": "ffmpeg",
  "separator_python": "python",
  "separator_models": "state/separator-models",
  "separator_model": "mel_band_roformer_karaoke_aufr33_viperx_sdr_10.1956.ckpt",
  "inference": {
    "index_rate": 1.0,
